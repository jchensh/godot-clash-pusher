# Godot 4+ 专用忽略项
.godot/

# 自动生成的翻译文件
*.translation

# 安卓导出构建模板与生成物
/android/

# 导出产物
/build/
/export/
*.apk
*.aab
*.pck
*.zip

# 编辑器/系统杂项
*.tmp
*.log
Thumbs.db
.DS_Store

# AI agent 本地状态目录(各 agent 自己的会话/缓存,不进仓)
.claude/
.codex/

# Office 临时锁文件（xlsx 开着时生成）
**/~$*

# Blender 生成管线（tools/blender）：Python 缓存与 Blender 自动备份不入库
__pycache__/
*.pyc
*.blend1
